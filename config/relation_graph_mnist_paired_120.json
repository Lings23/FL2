{
  "schema_version": 1,
  "purpose": "relation_graph_mnist_paired_clean_dba_pilot",
  "seed": 42,
  "dataset": "mnist",
  "architecture": "mnist_cnn",
  "normalization": "batch",
  "clients": 20,
  "malicious_clients": [0, 1, 2, 3],
  "groups": [
    {"name": "clean_fedavg", "attack": "none", "defense": "fedavg"},
    {"name": "clean_relation_graph", "attack": "none", "defense": "relation_graph"},
    {"name": "dba_fedavg", "attack": "dba", "defense": "fedavg"},
    {"name": "dba_relation_graph", "attack": "dba", "defense": "relation_graph"}
  ],
  "warmup_rounds": 0,
  "total_rounds": 120,
  "snapshots": [1, 10, 30, 60, 90, 120],
  "reference_probe_size": 300,
  "reference_gate_size": 200,
  "evaluator_validation_size": 2000,
  "max_client_samples": 500,
  "drop_last": true,
  "round_lr_decay": 0.99,
  "client": {
    "local_epochs": 2,
    "batch_size": 64,
    "optimizer": "sgd",
    "learning_rate": 0.1,
    "momentum": 0.0,
    "weight_decay": 0.0001,
    "lr_scheduler": "none"
  },
  "attack": {
    "malicious_fraction": 0.2,
    "backdoor_target_label": 7,
    "poison_fraction": 0.5,
    "reference_backdoor_dataset": "mnist",
    "neurotoxin_keep_ratio": 0.95,
    "neurotoxin_mask_source": "clean_gradient",
    "neurotoxin_aggregate_all_layer": true,
    "neurotoxin_clean_gradient_batches": 0,
    "poison_lr_multiplier": 1.0,
    "pgd_radius": 0.0,
    "pgd_radius_ratio": 1.0,
    "pgd_state_scope": "parameters",
    "pgd_radius_source": "benign_update_norm",
    "dba_scale_update": false,
    "dba_boost_factor": 1.0,
    "dba_pattern_mode": "paper_mnist_1x4_2x2",
    "dba_trigger_value_mode": "mnist_normalized_white",
    "dba_trigger_num": 4,
    "dba_gap": 2,
    "aggregation_aware_scaling": false,
    "attack_start_round": 1,
    "attack_end_round": 120
  },
  "relation_graph": {
    "settings": {
      "history_rounds": 12,
      "backbone_bins": 8,
      "min_reference_rounds": 3,
      "min_reference_pairs": 6,
      "residual_scale_floor": 0.05,
      "pair_shrinkage": 4.0,
      "pair_shift_limit": 0.15,
      "edge_z_threshold": 3.0,
      "edge_half_life": 4.0,
      "min_edge_confirmations": 2,
      "min_exceedance_fraction": 0.6,
      "min_group_density": 0.67,
      "min_boundary_fraction": 0.5,
      "min_calibrated_fraction": 0.5,
      "attenuation": 0.9
    }
  },
  "qualification": {
    "minimum_clean_accuracy": 0.95,
    "minimum_asr": 0.8,
    "minimum_asr_excess": 0.6,
    "maximum_accuracy_drop": 0.02,
    "sustained_rounds": 3
  },
  "evaluation_batch_size": 256,
  "evaluation_order_seed": 2042,
  "device": "cuda",
  "cpu_threads": 4,
  "interpretation": "One paired seed-42 IID pilot. Clean and DBA branches share the same initial model, split and client-seed rule; DBA uses four local MNIST fragments on clients 0-3 from round 1 to round 120 with the frozen poison rate and no upload amplification. relation_graph uses its current default settings. Malicious identities are used only for attack assignment and post-hoc evaluation. The 2000-example training holdout and 1800 non-target ASR denominator are shared by all branches; the final test set is unused. Conclusions are limited to this seed and IID protocol; graph-structure ablations are out of scope."
}